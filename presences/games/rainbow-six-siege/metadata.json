{
  "$schema": "../../../schemas/presence.schema.json",
  "id": "rainbow-six-siege",
  "name": "Rainbow Six Siege",
  "type": "game",
  "version": "1.1.0",
  "description": "Detects Rainbow Six Siege and, on supported Hammity Pulse runtimes, whether the game is the active Windows application.",
  "priority": 220,
  "detection": {
    "processes": [
      "RainbowSix.exe",
      "RainbowSix_DX12.exe",
      "RainbowSix_Vulkan.exe"
    ]
  },
  "activity": {
    "type": "playing",
    "name": "Rainbow Six Siege",
    "details": "Playing Rainbow Six Siege",
    "state": "Game running",
    "showElapsed": true,
    "assets": {
      "icon": "icon.png",
      "largeText": "Rainbow Six Siege"
    }
  },
  "contexts": [
    {
      "id": "window-active",
      "description": "OS reports that the running Siege window is the foreground application.",
      "when": {
        "dataEquals": {
          "r6.foreground": true
        }
      },
      "activity": {
        "type": "playing",
        "details": "Playing Rainbow Six Siege",
        "state": "Game window active"
      }
    },
    {
      "id": "window-background",
      "description": "OS reports that another window is in the foreground while Siege runs.",
      "when": {
        "dataEquals": {
          "r6.background": true
        }
      },
      "activity": {
        "type": "playing",
        "details": "Rainbow Six Siege running",
        "state": "Game in background"
      }
    }
  ]
}
