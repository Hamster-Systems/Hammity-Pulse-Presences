{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hammity.app/schemas/presence.schema.json",
  "title": "Hammity Pulse Presence",
  "description": "Metadata for a Hammity Pulse community Presence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "version",
    "description",
    "detection",
    "activity"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "type": {
      "type": "string",
      "enum": ["website", "game", "app"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 100
    },
    "website": { "type": "string" },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "windowTitles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "anyOf": [
        { "required": ["processes"] },
        { "required": ["windowTitles"] },
        { "required": ["domains"] }
      ]
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["playing", "watching", "listening", "using"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "showElapsed": {
          "type": "boolean",
          "default": true
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "icon": {
              "type": "string",
              "pattern": "^[^/\\\\]+\\.(?:png|jpg|jpeg|webp)$"
            },
            "largeImage": {
              "type": "string",
              "minLength": 1
            },
            "largeText": {
              "type": "string",
              "maxLength": 128
            },
            "smallImage": {
              "type": "string",
              "minLength": 1
            },
            "smallText": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "buttons": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    }
  }
}
