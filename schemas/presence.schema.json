{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hammity.app/schemas/presence.schema.json",
  "title": "Hammity Pulse Presence",
  "description": "Metadata for a Hammity Pulse community Presence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "version",
    "description"
  ],
  "anyOf": [
    { "required": ["activity"] },
    { "required": ["entry"] }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "type": {
      "type": "string",
      "enum": ["website", "game", "app"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "entry": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.(?:js|mjs)$"
    },
    "website": { "type": "string" },
    "processes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
