{
  "$schema": "../../../schemas/presence.schema.json",
  "id": "twitch",
  "name": "Twitch",
  "type": "website",
  "version": "1.1.0",
  "description": "Rich Twitch stream and creator activity.",
  "priority": 170,
  "detection": {
    "domains": [
      "twitch.tv"
    ]
  },
  "browserExtraction": {
    "title": {
      "selectors": [
        {
          "selector": "h2[data-a-target=\"stream-title\"]"
        },
        {
          "selector": "meta[property=\"og:title\"]",
          "attribute": "content"
        },
        {
          "selector": "meta[name=\"twitter:title\"]",
          "attribute": "content"
        }
      ],
      "stripSuffixes": [
        " - Twitch"
      ]
    },
    "author": {
      "selectors": [
        {
          "selector": "a[data-a-target=\"user-channel-header-item\"]"
        },
        {
          "selector": "a[data-a-target=\"channel-name\"]"
        },
        {
          "selector": "h1[data-a-target=\"channel-header-title\"]"
        }
      ],
      "pathSegment": 0
    },
    "image": {
      "rules": [
        {
          "selectors": [
            {
              "selector": "meta[property=\"og:image\"]",
              "attribute": "content"
            },
            {
              "selector": "meta[name=\"twitter:image\"]",
              "attribute": "content"
            }
          ]
        }
      ]
    },
    "mediaSelector": "video",
    "authorImage": {
      "selectors": [
        {
          "selector": "img[data-a-target=\"profile-image\"]",
          "attribute": "src"
        },
        {
          "selector": "img[data-a-target=\"user-avatar\"]",
          "attribute": "src"
        },
        {
          "selector": "[data-test-selector=\"channel-header-avatar\"] img",
          "attribute": "src"
        },
        {
          "selector": "[data-a-target=\"channel-header\"] img",
          "attribute": "src"
        }
      ]
    }
  },
  "activity": {
    "type": "watching",
    "name": "Twitch",
    "details": "Browsing Twitch",
    "state": "Hammity Pulse Browser",
    "showElapsed": false,
    "assets": {
      "icon": "icon.png",
      "largeText": "Twitch"
    },
    "timestampMode": "none"
  },
  "contexts": [
    {
      "id": "stream-playing",
      "description": "Watching a Twitch stream.",
      "when": {
        "browserHasMedia": true,
        "browserMediaStateEquals": "playing"
      },
      "activity": {
        "type": "watching",
        "details": "Watching {browser.pageTitle}",
        "state": "{browser.author}",
        "assets": {
          "largeImage": "{browser.authorImage}",
          "largeText": "{browser.author}",
          "smallImage": "icon.png",
          "smallText": "Twitch"
        },
        "timestampMode": "media",
        "showElapsed": true
      }
    },
    {
      "id": "stream-paused",
      "description": "Paused on a Twitch stream.",
      "when": {
        "browserHasMedia": true,
        "browserMediaStateEquals": "paused"
      },
      "activity": {
        "type": "watching",
        "details": "Paused {browser.pageTitle}",
        "state": "{browser.author}",
        "assets": {
          "largeImage": "{browser.authorImage}",
          "largeText": "{browser.author}",
          "smallImage": "icon.png",
          "smallText": "Twitch"
        },
        "timestampMode": "none",
        "showElapsed": false
      }
    },
    {
      "id": "channel",
      "description": "Viewing a Twitch creator channel.",
      "when": {
        "browserPathnameRegex": "^/[^/]+/?$"
      },
      "activity": {
        "type": "watching",
        "details": "Viewing {browser.author}",
        "state": "Twitch channel",
        "assets": {
          "largeImage": "{browser.authorImage}",
          "largeText": "{browser.author}",
          "smallImage": "icon.png",
          "smallText": "Twitch"
        },
        "timestampMode": "none",
        "showElapsed": false
      }
    }
  ]
}
