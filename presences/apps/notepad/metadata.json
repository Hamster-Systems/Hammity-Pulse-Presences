{
  "$schema": "../../../schemas/presence.schema.json",
  "id": "notepad",
  "name": "Notepad",
  "type": "app",
  "version": "1.2.0",
  "description": "Basic Notepad activity detection.",
  "priority": 100,
  "detection": {
    "processes": [
      "notepad.exe"
    ]
  },
  "activity": {
    "type": "using",
    "name": "Notepad",
    "details": "Using Notepad",
    "state": "Detected by Hammity Pulse",
    "showElapsed": true,
    "assets": {
      "icon": "icon.png",
      "largeText": "Notepad"
    }
  },
  "contexts": [
    {
      "id": "new-document",
      "description": "Detects an unsaved new Notepad document without exposing document contents.",
      "when": {
        "windowTitleRegex": "^Untitled(?:\\s*-\\s*Notepad)?$"
      },
      "activity": {
        "type": "using",
        "details": "Working on a new text document",
        "state": "Notepad"
      }
    },
    {
      "id": "text-document",
      "description": "Generic editing state for a named Notepad document without exposing its filename.",
      "when": {
        "windowTitleRegex": ".+\\s*-\\s*Notepad$"
      },
      "activity": {
        "type": "using",
        "details": "Editing a text document",
        "state": "Notepad"
      }
    }
  ]
}
