{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hammity.app/schemas/presence.schema.json",
  "title": "Hammity Pulse Presence",
  "description": "Metadata for a Hammity Pulse community Presence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "version",
    "description",
    "detection",
    "activity"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "type": {
      "type": "string",
      "enum": [
        "website",
        "game",
        "app"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 100
    },
    "website": {
      "type": "string"
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "windowTitles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "captureWindowTitle": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "processes"
          ]
        },
        {
          "required": [
            "windowTitles"
          ]
        },
        {
          "required": [
            "domains"
          ]
        }
      ]
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activity"
        ],
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 160
          },
          "defaultTtlMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 60000
          },
          "activity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "playing",
                  "watching",
                  "listening",
                  "using"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "details": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "showElapsed": {
                "type": "boolean"
              },
              "assets": {
                "type": "object"
              },
              "buttons": {
                "type": "array",
                "maxItems": 2
              },
              "timestampMode": {
                "type": "string",
                "enum": [
                  "elapsed",
                  "media",
                  "none"
                ]
              }
            }
          }
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "playing",
            "watching",
            "listening",
            "using"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "showElapsed": {
          "type": "boolean",
          "default": true
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "icon": {
              "type": "string",
              "pattern": "^[^/\\\\]+\\.(?:png|jpg|jpeg|webp)$"
            },
            "largeImage": {
              "type": "string",
              "minLength": 1
            },
            "largeText": {
              "type": "string",
              "maxLength": 128
            },
            "smallImage": {
              "type": "string",
              "minLength": 1
            },
            "smallText": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "buttons": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "timestampMode": {
          "type": "string",
          "enum": [
            "elapsed",
            "media",
            "none"
          ]
        }
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "activity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "maxLength": 160
          },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "windowTitleEquals": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "windowTitleIncludes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "windowTitleRegex": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "browserPathnameEquals": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "browserPathnameIncludes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "browserPathnameRegex": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "browserTitleIncludes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "browserMediaStateEquals": {
                "type": "string",
                "enum": [
                  "playing",
                  "paused"
                ]
              },
              "browserHasMedia": {
                "type": "boolean"
              },
              "dataEquals": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "anyOf": [
              {
                "required": [
                  "windowTitleEquals"
                ]
              },
              {
                "required": [
                  "windowTitleIncludes"
                ]
              },
              {
                "required": [
                  "windowTitleRegex"
                ]
              },
              {
                "required": [
                  "browserPathnameEquals"
                ]
              },
              {
                "required": [
                  "browserPathnameIncludes"
                ]
              },
              {
                "required": [
                  "browserPathnameRegex"
                ]
              },
              {
                "required": [
                  "browserTitleIncludes"
                ]
              },
              {
                "required": [
                  "browserMediaStateEquals"
                ]
              },
              {
                "required": [
                  "browserHasMedia"
                ]
              },
              {
                "required": [
                  "dataEquals"
                ]
              }
            ]
          },
          "activity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "playing",
                  "watching",
                  "listening",
                  "using"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "details": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "showElapsed": {
                "type": "boolean"
              },
              "assets": {
                "type": "object"
              },
              "buttons": {
                "type": "array",
                "maxItems": 2
              },
              "timestampMode": {
                "type": "string",
                "enum": [
                  "elapsed",
                  "media",
                  "none"
                ]
              }
            }
          }
        }
      }
    },
    "browserExtraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selectors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "selector"
                ],
                "properties": {
                  "selector": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "attribute": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              }
            },
            "stripSuffixes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selectors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "selector"
                ],
                "properties": {
                  "selector": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "attribute": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              }
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "whenPathnameEquals": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "whenPathnameRegex": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "queryParam": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "template": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "selectors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "selector"
                      ],
                      "properties": {
                        "selector": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "attribute": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "mediaSelector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "events": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9:_-]{1,64}$"
          }
        }
      }
    }
  }
}
