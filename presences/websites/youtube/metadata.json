{
  "$schema": "../../../schemas/presence.schema.json",
  "id": "youtube",
  "name": "YouTube",
  "type": "website",
  "version": "1.2.0",
  "description": "Rich YouTube browser activity with video, channel and playback context.",
  "priority": 160,
  "detection": {
    "domains": [
      "youtube.com"
    ]
  },
  "activity": {
    "type": "watching",
    "name": "YouTube",
    "details": "Browsing YouTube",
    "state": "Hammity Pulse Browser",
    "showElapsed": true,
    "assets": {
      "icon": "icon.png",
      "largeText": "YouTube"
    },
    "timestampMode": "elapsed"
  },
  "contexts": [
    {
      "id": "video-playing",
      "description": "Shows the current YouTube video thumbnail and playing state.",
      "when": {
        "browserPathnameEquals": "/watch",
        "browserMediaStateEquals": "playing"
      },
      "activity": {
        "type": "watching",
        "details": "Watching a video",
        "state": "{browser.pageTitle}",
        "assets": {
          "largeImage": "{browser.pageImage}",
          "largeText": "{browser.pageTitle}",
          "smallImage": "play.png",
          "smallText": "Playing"
        },
        "timestampMode": "media",
        "showElapsed": true
      }
    },
    {
      "id": "video-paused",
      "description": "Shows the current YouTube video thumbnail and paused state.",
      "when": {
        "browserPathnameEquals": "/watch",
        "browserMediaStateEquals": "paused"
      },
      "activity": {
        "type": "watching",
        "details": "Video paused",
        "state": "{browser.pageTitle}",
        "assets": {
          "largeImage": "{browser.pageImage}",
          "largeText": "{browser.pageTitle}",
          "smallImage": "pause.png",
          "smallText": "Paused"
        },
        "timestampMode": "none",
        "showElapsed": false
      }
    },
    {
      "id": "watch-page",
      "description": "Fallback for a YouTube watch page before media state is available.",
      "when": {
        "browserPathnameEquals": "/watch"
      },
      "activity": {
        "type": "watching",
        "details": "Watching a video",
        "state": "{browser.pageTitle}",
        "assets": {
          "largeImage": "{browser.pageImage}",
          "largeText": "{browser.pageTitle}"
        },
        "timestampMode": "none",
        "showElapsed": false
      }
    },
    {
      "id": "channel",
      "description": "Shows a YouTube channel page using its page image when available.",
      "when": {
        "browserPathnameRegex": "^/(?:@[^/]+|channel/|c/|user/)"
      },
      "activity": {
        "type": "watching",
        "details": "Viewing a channel",
        "state": "{browser.pageTitle}",
        "assets": {
          "largeImage": "{browser.pageImage}",
          "largeText": "{browser.pageTitle}"
        },
        "timestampMode": "none",
        "showElapsed": false
      }
    },
    {
      "id": "shorts-playing",
      "description": "Shows YouTube Shorts playback.",
      "when": {
        "browserPathnameRegex": "^/shorts/",
        "browserMediaStateEquals": "playing"
      },
      "activity": {
        "type": "watching",
        "details": "Watching YouTube Shorts",
        "state": "{browser.pageTitle}",
        "assets": {
          "largeImage": "{browser.pageImage}",
          "largeText": "{browser.pageTitle}",
          "smallImage": "play.png",
          "smallText": "Playing"
        },
        "timestampMode": "media",
        "showElapsed": true
      }
    },
    {
      "id": "shorts-paused",
      "description": "Shows a paused YouTube Short.",
      "when": {
        "browserPathnameRegex": "^/shorts/",
        "browserMediaStateEquals": "paused"
      },
      "activity": {
        "type": "watching",
        "details": "Short paused",
        "state": "{browser.pageTitle}",
        "assets": {
          "largeImage": "{browser.pageImage}",
          "largeText": "{browser.pageTitle}",
          "smallImage": "pause.png",
          "smallText": "Paused"
        },
        "timestampMode": "none",
        "showElapsed": false
      }
    }
  ]
}
