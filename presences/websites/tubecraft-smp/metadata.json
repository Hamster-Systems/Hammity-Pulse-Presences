{
  "$schema": "../../../schemas/presence.schema.json",
  "id": "tubecraft-smp",
  "name": "TubeCraft SMP",
  "type": "website",
  "version": "1.0.0",
  "description": "Rich TubeCraft SMP community website activity, ported from the existing PreMiD Presence.",
  "priority": 190,
  "website": "https://tubecraftsmp.com",
  "detection": {
    "domains": [
      "tubecraftsmp.com"
    ]
  },
  "browserExtraction": {
    "title": {
      "selectors": [
        {
          "selector": "h1"
        },
        {
          "selector": "meta[property=\"og:title\"]",
          "attribute": "content"
        },
        {
          "selector": "title"
        }
      ],
      "stripSuffixes": [
        " | TubeCraft SMP",
        " - TubeCraft SMP"
      ]
    },
    "image": {
      "rules": [
        {
          "selectors": [
            {
              "selector": "meta[property=\"og:image\"]",
              "attribute": "content"
            },
            {
              "selector": "meta[name=\"twitter:image\"]",
              "attribute": "content"
            }
          ]
        }
      ]
    }
  },
  "activity": {
    "type": "using",
    "name": "TubeCraft SMP",
    "details": "Browsing TubeCraft SMP",
    "state": "{browser.pageTitle}",
    "showElapsed": true,
    "timestampMode": "elapsed",
    "assets": {
      "icon": "logo.png",
      "largeImage": "logo.png",
      "largeText": "TubeCraft SMP"
    },
    "buttons": [
      {
        "label": "Open TubeCraft SMP",
        "url": "https://tubecraftsmp.com"
      }
    ]
  },
  "contexts": [
    {
      "id": "admin-application-settings",
      "description": "TubeCraft SMP: Application Settings",
      "when": {
        "browserPathnameIncludes": "/admin/application_settings"
      },
      "activity": {
        "type": "using",
        "details": "Configuring Applications",
        "state": "Application Settings",
        "assets": {
          "icon": "logo.png",
          "largeImage": "logo.png",
          "largeText": "TubeCraft SMP"
        },
        "timestampMode": "elapsed",
        "showElapsed": true
      }
    },
    {
      "id": "admin-applications",
      "description": "TubeCraft SMP: Application Manager",
      "when": {
