{
  "$schema": "../../../schemas/presence.schema.json",
  "id": "youtube",
  "name": "YouTube",
  "type": "website",
  "version": "1.4.0",
  "description": "Rich YouTube browser activity with video, channel and playback context.",
  "priority": 160,
  "detection": {
    "domains": [
      "youtube.com"
    ]
  },
  "activity": {
    "type": "watching",
    "name": "YouTube",
    "details": "Browsing YouTube",
    "state": "Hammity Pulse Browser",
    "showElapsed": true,
    "assets": {
      "icon": "icon.png",
      "largeText": "YouTube"
    },
    "timestampMode": "elapsed"
  },
  "contexts": [
    {
      "id": "video-playing",
      "description": "Shows the current YouTube video thumbnail and playing state.",
      "when": {
        "browserPathnameEquals": "/watch",
        "browserMediaStateEquals": "playing"
      },
      "activity": {
        "type": "watching",
        "details": "Watching {browser.pageTitle}",
        "state": "{browser.author}",
        "assets": {
          "largeImage": "{browser.pageImage}",
          "largeText": "{browser.pageTitle}",
          "smallImage": "play.png",
          "smallText": "Playing"
        },
        "timestampMode": "media",
        "showElapsed": true
      }
    },
    {
      "id": "video-paused",
      "description": "Shows the current YouTube video thumbnail and paused state.",
      "when": {
        "browserPathnameEquals": "/watch",
        "browserMediaStateEquals": "paused"
      },
      "activity": {
        "type": "watching",
        "details": "Paused {browser.pageTitle}",
        "state": "{browser.author}",
        "assets": {
          "largeImage": "{browser.pageImage}",
          "largeText": "{browser.pageTitle}",
          "smallImage": "pause.png",
          "smallText": "Paused"
        },
        "timestampMode": "none",
        "showElapsed": false
      }
    },
    {
      "id": "watch-page",
      "description": "Fallback for a YouTube watch page before media state is available.",
      "when": {
        "browserPathnameEquals": "/watch"
      },
      "activity": {
        "type": "watching",
        "details": "Watching {browser.pageTitle}",
        "state": "{browser.author}",
        "assets": {
          "largeImage": "{browser.pageImage}",
          "largeText": "{browser.pageTitle}"
        },
        "timestampMode": "none",
        "showElapsed": false
      }
    },
    {
      "id": "channel",
      "description": "Shows a YouTube channel page using its page image when available.",
      "when": {
        "browserPathnameRegex": "^/(?:@[^/]+|channel/|c/|user/)"
      },
      "activity": {
        "type": "watching",
        "details": "Viewing a channel",
        "state": "{browser.pageTitle}",
        "assets": {
          "largeImage": "{browser.pageImage}",
          "largeText": "{browser.pageTitle}"
        },
        "timestampMode": "none",
        "showElapsed": false
      }
    },
    {
      "id": "shorts-playing",
      "description": "Shows YouTube Shorts playback.",
      "when": {
        "browserPathnameRegex": "^/shorts/",
        "browserMediaStateEquals": "playing"
      },
      "activity": {
        "type": "watching",
        "details": "Watching {browser.pageTitle}",
        "state": "{browser.author}",
        "assets": {
          "largeImage": "{browser.pageImage}",
          "largeText": "{browser.pageTitle}",
          "smallImage": "play.png",
          "smallText": "Playing"
        },
        "timestampMode": "media",
        "showElapsed": true
      }
    },
    {
      "id": "shorts-paused",
      "description": "Shows a paused YouTube Short.",
      "when": {
        "browserPathnameRegex": "^/shorts/",
        "browserMediaStateEquals": "paused"
      },
      "activity": {
        "type": "watching",
        "details": "Paused {browser.pageTitle}",
        "state": "{browser.author}",
        "assets": {
          "largeImage": "{browser.pageImage}",
          "largeText": "{browser.pageTitle}",
          "smallImage": "pause.png",
          "smallText": "Paused"
        },
        "timestampMode": "none",
        "showElapsed": false
      }
    }
  ],
  "browserExtraction": {
    "title": {
      "selectors": [
        {
          "selector": "ytd-watch-metadata h1 yt-formatted-string"
        },
        {
          "selector": "h1.ytd-watch-metadata yt-formatted-string"
        },
        {
          "selector": "meta[itemprop=\"name\"]",
          "attribute": "content"
        },
        {
          "selector": "meta[property=\"og:title\"]",
          "attribute": "content"
        },
        {
          "selector": "meta[name=\"twitter:title\"]",
          "attribute": "content"
        },
        {
          "selector": "h1"
        }
      ],
      "stripSuffixes": [
        " - YouTube"
      ]
    },
    "author": {
      "selectors": [
        {
          "selector": "ytd-watch-metadata ytd-channel-name a"
        },
        {
          "selector": "#owner ytd-channel-name a"
        },
        {
          "selector": "#channel-name a"
        },
        {
          "selector": "meta[itemprop=\"author\"]",
          "attribute": "content"
        },
        {
          "selector": "meta[name=\"author\"]",
          "attribute": "content"
        }
      ]
    },
    "image": {
      "rules": [
        {
          "whenPathnameEquals": "/watch",
          "queryParam": "v",
          "template": "https://i.ytimg.com/vi/{value}/hqdefault.jpg"
        },
        {
          "whenPathnameRegex": "^/(?:@[^/]+|channel/|c/|user/)",
          "selectors": [
            {
              "selector": "ytd-page-header-renderer #avatar img",
              "attribute": "src"
            },
            {
              "selector": "ytd-c4-tabbed-header-renderer #avatar img",
              "attribute": "src"
            },
            {
              "selector": "yt-page-header-renderer #avatar img",
              "attribute": "src"
            },
            {
              "selector": "#channel-header-container #avatar img",
              "attribute": "src"
            }
          ]
        },
        {
          "selectors": [
            {
              "selector": "meta[itemprop=\"thumbnailUrl\"]",
              "attribute": "content"
            },
            {
              "selector": "link[itemprop=\"thumbnailUrl\"]",
              "attribute": "href"
            },
            {
              "selector": "meta[property=\"og:image\"]",
              "attribute": "content"
            },
            {
              "selector": "meta[name=\"twitter:image\"]",
              "attribute": "content"
            },
            {
              "selector": "link[rel=\"image_src\"]",
              "attribute": "href"
            }
          ]
        }
      ]
    },
    "mediaSelector": "video, audio",
    "events": [
      "yt-navigate-finish",
      "yt-page-data-updated"
    ]
  }
}
